# Copy this file to .env, then fill in the values. .env is gitignored.
# Compose stops if OPENCODE_GO_API_KEY is empty.

# OpenCode Go key (oc_sk_...).
OPENCODE_GO_API_KEY=

# DeepSeek key (sk-...) from platform.deepseek.com.
DEEPSEEK_API_KEY=

# Devin model-API key. Set it to use a fresh key. Leave it empty to use the
# mounted ~/.local/share/devin/credentials.toml.
# Use a model-API session token: devin-session-token$... or the raw token from
# the Devin CLI sign-in. Devin agent keys (apk_/dev_/pat_) are a different
# product and do not work for model chat.
# Keep the single quotes: Compose expands $ in unquoted values, and a session
# token contains one.
DEVIN_API_KEY=''
